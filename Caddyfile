# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
#
# The `ping-us.faizo.net` DNS record points at this host's IP in either mode:
#   - "DNS only" (grey cloud): fastest, no Cloudflare hop. Caddy issues and
#     renews certs via the ACME HTTP-01 / TLS-ALPN-01 challenges on 80/443.
#   - "Proxied" (orange cloud): hides the origin IP and adds DDoS shielding;
#     set the zone's SSL/TLS mode to "Full (strict)". HTTP-01 renewals still
#     pass through the proxy on port 80 (TLS-ALPN-01 doesn't — Caddy falls
#     back to HTTP-01 automatically).
# Certificates are persisted in the `caddy_data` volume (see compose.yml) so
# restarts don't re-issue.
#
# To route more hostnames to other containers on this box (the same job the
# tunnel dashboard's "public hostname" list does), add a block per service.
# E.g. to move api-dweeb off the tunnel: publish a loopback port in the dweeb
# compose (127.0.0.1:4444:8080) and add
#
#   api-dweeb.faizo.net {
#   	log
#   	reverse_proxy 127.0.0.1:4444
#   }
{
	# ACME account email — used for expiry notices and recovery.
	email mail@faizo.net
}

ping-us.faizo.net {
	# Caddy runs in host-network mode (see compose.yml) so its WAN-facing
	# sockets use the host TCP stack (BBR, Fast Open) with no bridge hop; it
	# reaches the app over loopback. No `encode` — responses are tiny JSON,
	# below the compression threshold, so it would only add work.
	# Access log (JSON to stderr -> `docker logs caddy`): records each
	# request's source IP and User-Agent, e.g. to confirm traffic really
	# originates from Discord's webhook fleet.
	log
	reverse_proxy 127.0.0.1:8080
}
